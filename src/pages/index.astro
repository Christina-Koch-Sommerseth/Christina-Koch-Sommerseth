<!doctype html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Personlig portefølje – student og jobbsøker." />
  <title>Christina Koch Sommerseth | Innovasjonsledelse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="header wrap">
    <a class="monogram" href="#hjem" aria-label="Til forsiden">CKS</a>
    <nav aria-label="Hovedmeny">
      <a href="#hjem">Hjem</a><a href="#om">Om meg</a><a href="#utdanning">Utdanning</a><a href="#erfaring">Erfaring</a><a href="#referanser">Referanser</a><a href="#ferdigheter">Ferdigheter</a><a href="#kontakt">Kontakt</a>
    </nav>
  </header>
  <main>
    <section class="hero wrap" id="hjem">
      <div class="hero-copy">
        <p class="eyebrow">CHRISTINA KOCH SOMMERSETH</p>
        <h1>Masterstudent med blikket rettet mot fremtiden</h1>
        <p class="lead">Jeg er masterstudent i innovasjonsledelse ved Høyskolen Kristiania, med bachelor i markedsføringsledelse fra BI. Jeg interesserer meg for strategi, mennesker og nye løsninger som skaper verdi.</p>
        <div class="actions"><a class="button primary" href="/Christina-Koch-Sommerseth/CV%202026.pdf" target="_blank" rel="noopener noreferrer">Se min CV <span aria-hidden="true">↗</span></a><a class="button outline" href="#kontakt">Kontakt meg <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="portrait-wrap"><div class="blob"></div><div class="portrait"><img src={`${import.meta.env.BASE_URL}portrait.jpg`} alt="Portrett av Christina Koch Sommerseth" width="600" height="800" loading="eager" /></div></div>
    </section>
    <section class="about wrap" id="om">
      <div><p class="eyebrow">OM MEG</p><h2>En analytisk og kreativ problemløser</h2><p>Gjennom studier, markedsarbeid og lederroller har jeg fått erfaring med analyse, kommunikasjon, samarbeid og prosjektarbeid. Jeg trives med å omsette innsikt til konkrete ideer og løsninger.</p></div>
      <div class="traits" id="cv"><div class="cv-intro"><div><h2>CV</h2><p>Få en oversikt over utdanning, erfaring og kompetanse. Den nedlastbare PDF-en legges til her.</p><a class="button primary" href="#utdanning">Se min erfaring <span aria-hidden="true">→</span></a></div><div class="cv-symbol" aria-hidden="true">▤</div></div><div class="traits-grid">
        <article><div class="symbol">✦</div><h3>Nysgjerrig</h3><p>Åpen for nye perspektiver og muligheter.</p></article>
        <article><div class="symbol">♡</div><h3>Engasjert</h3><p>Motivert for å lære og bidra.</p></article>
        <article><div class="symbol">↗</div><h3>Utvikling</h3><p>Ønsker å vokse faglig og personlig.</p></article>
        <article><div class="symbol">◎</div><h3>Samarbeid</h3><p>Verdsetter gode relasjoner og samarbeid.</p></article>
      </div></div>
    </section>
    <div class="career-flow"><section class="section pale" id="utdanning"><div class="wrap"><h2>Utdanning <span class="accent-line"></span></h2>{education.map(item => <article class="timeline"><span class="period">{item.period}</span><div><h3>{item.title}</h3><p>{item.place}<br />{item.detail}</p></div></article>)}</div></section>
    <section class="section" id="erfaring"><div class="wrap"><h2>Erfaring <span class="accent-line"></span></h2>{experience.map(item => <article class="timeline"><span class="period">{item.period}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></article>)}</div></section>
    </div><section class="references section" id="referanser"><div class="wrap reference-layout"><div><h2>Referanser <span class="accent-line"></span></h2><p>Referanser oppgis på forespørsel. Kontaktinformasjon til referansepersoner legges inn når den er klar.</p></div><div class="reference-card"><div class="reference-icon" aria-hidden="true">♧</div><div><h3>Referanser oppgis senere</h3><p>Ta gjerne kontakt dersom du ønsker referanser.</p></div></div></div></section><section class="bottom" id="ferdigheter"><div class="wrap bottom-grid"><div><h2>Ferdigheter <span class="accent-line"></span></h2><div class="pills">{skills.map(skill => <span class="pill">{skill}</span>)}</div></div><div id="kontakt"><h2>Kontakt <span class="accent-line"></span></h2><p><a href="tel:+4794149099">+47 941 49 099</a></p><p><a href="mailto:christina.sommerseth@gmail.com">christina.sommerseth@gmail.com</a></p><p>Oslo, Norge</p></div></div></section>
  </main>
  <footer class="wrap"><span>Personlig portefølje</span><a href="#hjem">Til toppen ↑</a></footer>
</body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth} :global(body){margin:0;background:#faf8f5;color:#171b3d;font-family:'DM Sans',sans-serif} :global(a){color:inherit;text-decoration:none} :global(p){line-height:1.75;color:#626a7e} :global(h1),:global(h2),:global(h3){font-family:'Playfair Display',Georgia,serif} :global(h2){font-size:clamp(2rem,4vw,3.1rem);line-height:1.17;margin:0 0 24px} .wrap{max-width:1160px;margin:auto;padding-left:32px;padding-right:32px}.header{min-height:90px;display:flex;justify-content:space-between;align-items:center;gap:24px}.monogram{font-family:Georgia,serif;font-weight:700;letter-spacing:.08em;font-size:17px}.header nav{display:flex;gap:28px;flex-wrap:wrap;font-size:13px;font-weight:600}.header nav a:hover{color:#438fc5}.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:70px;min-height:570px;padding-top:30px;padding-bottom:65px}.eyebrow{color:#d1a88f;letter-spacing:.22em;font-weight:700;font-size:12px}.hero h1{font-size:clamp(2.7rem,5vw,4.7rem);line-height:1.08;letter-spacing:-.035em;margin:22px 0}.lead{font-size:17px;max-width:490px}.actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}.button{display:inline-flex;gap:25px;align-items:center;border-radius:100px;padding:15px 24px;font-size:13px;font-weight:700;border:1px solid #171b3d}.primary{background:#171b3d;color:white}.outline{background:transparent}.portrait-wrap{position:relative;min-height:460px;display:grid;place-items:center}.blob{position:absolute;inset:5% 0 3% 0;background:#d9eefc;border-radius:46% 54% 58% 42% / 50% 37% 63% 50%;transform:rotate(-17deg)}.portrait{position:relative;display:grid;place-items:center;width:76%;height:400px;background:linear-gradient(145deg,#e6d8cc,#f4eee8);border-radius:49% 51% 47% 53% / 57% 42% 58% 43%;transform:rotate(8deg);padding:30px;text-align:center}.portrait span{transform:rotate(-8deg);color:#79717a;font-size:14px}.about{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-top:80px;padding-bottom:100px}.about>div>p{max-width:500px}.traits{background:#eef6fb;border-radius:24px;padding:34px;display:grid;grid-template-columns:1fr 1fr;gap:28px}.traits h3{font-size:20px;margin:8px 0}.traits p{font-size:13px;margin:0}.symbol{display:grid;place-items:center;background:#d7ecfa;color:#438fc5;width:56px;height:56px;border-radius:50%;font-size:28px}.section{padding:85px 0 110px;min-height:300px}.pale{background:linear-gradient(110deg,#faf8f5 70%,#e3f2fc)}.accent-line{display:inline-block;vertical-align:middle;width:45px;height:2px;background:#d8b49e;margin-left:14px}.placeholder{border-left:2px solid #438fc5;padding:15px 0 15px 25px;max-width:600px}.bottom{background:linear-gradient(130deg,#e2f2fc,#d5eafa);padding:85px 0 105px}.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px}.bottom-grid>div+div{border-left:1px solid #bdd5e4;padding-left:55px}.small{font-size:13px}footer{padding-top:30px!important;padding-bottom:30px!important;display:flex;justify-content:space-between;color:#626a7e;font-size:13px}
  @media(max-width:760px){.header{align-items:flex-start;flex-direction:column;padding-top:25px;padding-bottom:20px}.header nav{gap:13px 20px}.hero,.about,.bottom-grid{grid-template-columns:1fr;gap:35px}.hero{padding-top:40px}.portrait-wrap{min-height:350px}.portrait{height:310px;max-width:300px}.about{padding-top:35px;padding-bottom:65px}.traits{padding:25px}.bottom-grid>div+div{border:0;padding-left:0}.section,.bottom{padding-top:60px;padding-bottom:75px}.wrap{padding-left:22px;padding-right:22px}}
.timeline{display:grid;grid-template-columns:140px 1fr;gap:20px;position:relative;padding:10px 0 25px}.timeline:before{content:'';position:absolute;left:150px;top:22px;bottom:-10px;width:1px;background:#c7d9e5}.timeline:after{content:'';position:absolute;left:145px;top:18px;width:11px;height:11px;border-radius:50%;background:#438fc5}.timeline>div{padding-left:25px}.timeline h3{font-family:'DM Sans',sans-serif;font-size:16px;margin:0 0 5px}.timeline p{margin:0;font-size:14px}.period{color:#778195;font-size:14px}.pills{display:flex;flex-wrap:wrap;gap:10px}.pill{background:#ffffff99;padding:10px 14px;border-radius:25px;color:#365778;font-size:13px}@media(max-width:600px){.timeline{grid-template-columns:85px 1fr;gap:10px}.timeline:before{left:94px}.timeline:after{left:89px}.timeline>div{padding-left:20px}} .career-flow{position:relative;isolation:isolate;overflow:hidden}.career-flow:before{content:"";position:absolute;right:-7%;top:3%;width:22%;height:95%;z-index:-1;background:#d9eefc;border-radius:52% 48% 65% 35% / 24% 55% 45% 76%;transform:rotate(-5deg)}.career-flow .pale{background:transparent}.career-flow .wrap{position:relative;z-index:1}.career-flow .timeline{max-width:78%}.references{background:#f4f9fd;padding-top:72px;padding-bottom:85px}.reference-card{max-width:620px;background:white;border:1px solid #d9e9f3;border-radius:22px;padding:28px;display:flex;gap:20px;align-items:center;box-shadow:0 12px 35px #171b3d08}.reference-card h3{margin:0 0 6px;font-size:21px}.reference-card p{margin:0}.reference-icon{width:60px;height:60px;flex-shrink:0;border-radius:50%;background:#d9eefc;color:#438fc5;display:grid;place-items:center;font-size:28px}@media(max-width:760px){.career-flow:before{display:none}.career-flow .timeline{max-width:100%}.reference-card{padding:22px}} .monogram{font-size:29px;line-height:1}.traits{display:block;background:#e4f3fc;padding:30px}.cv-intro{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:0 0 26px;margin-bottom:24px;border-bottom:1px solid #c3ddea}.cv-intro h2{margin:0 0 4px}.cv-intro p{margin:0 0 18px;font-size:14px}.cv-intro .button{font-size:12px}.cv-symbol{font-size:65px;color:#438fc5}.traits-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.reference-layout{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}.references{background:#e3f3fd}.reference-card{background:#ffffffb8}.career-flow:before{right:-10%;width:23%;background:#cdeaff}.hero .blob{background:#cdeaff}.bottom{background:linear-gradient(130deg,#d9efff,#c5e6fa)}@media(max-width:760px){.reference-layout{grid-template-columns:1fr}.cv-intro{align-items:flex-start}.cv-symbol{font-size:42px}} .portrait{overflow:hidden;padding:0;background:#faf8f5}.portrait img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 28%;transform:rotate(-8deg) scale(1.17);border-radius:inherit}

/* Larger organic vertical wave with varied thickness, safely beside the text. */
.career-flow{position:relative;isolation:isolate;overflow:hidden}
.career-flow::before{content:"";position:absolute;right:0;top:0;bottom:0;width:clamp(135px,24vw,355px);height:100%;z-index:-1;background:transparent url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20360%201000%22%20preserveAspectRatio%3D%22none%22%3E%3Cpath%20fill%3D%22%23d9eefc%22%20d%3D%22M360%200%20C350%2042%20225%2065%20210%20130%20C192%20208%20330%20231%20310%20307%20C286%20393%20115%20390%2096%20485%20C76%20585%20315%20566%20286%20670%20C267%20744%20130%20747%20145%20830%20C159%20908%20343%20922%20360%201000%20Z%22%2F%3E%3C%2Fsvg%3E") no-repeat right center;background-size:100% 100%;clip-path:none;transform:none;border-radius:0}
.career-flow .timeline{max-width:72%}
@media(max-width:760px){.career-flow::before{display:none}.career-flow .timeline{max-width:100%}}

/* Continuous soft decorative wave, from portrait to contact. */
main{position:relative;isolation:isolate;overflow:hidden}
main::before{content:"";position:absolute;top:130px;right:-7%;bottom:0;width:38%;z-index:1;pointer-events:none;background:#d9eefc;border-radius:63% 37% 58% 42% / 11% 23% 32% 34%;transform:rotate(3deg)}
main > *{position:relative;z-index:2}
.career-flow::before{display:none!important}
.career-flow .timeline{max-width:72%}
.career-flow .pale{background:transparent}
.references{background:rgba(244,249,253,.82)}
.bottom{background:linear-gradient(130deg,rgba(226,242,252,.88),rgba(213,234,250,.72))}
@media(max-width:760px){main::before{width:25%;opacity:.3}.career-flow .timeline{max-width:100%}}

/* Tapered wave asset: slim by the portrait, flowing more freely below. */
main::before{top:130px;right:0;bottom:0;width:clamp(180px,38vw,510px);background:transparent url('/Christina-Koch-Sommerseth/vertical-wave.svg') no-repeat right center;background-size:100% 100%;border-radius:0;transform:none;opacity:1}
@media(max-width:760px){main::before{width:35vw;opacity:.32}}
</style>
